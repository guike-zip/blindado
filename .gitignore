# macOS
.DS_Store

# Python cache (Spec Kit scripts)
__pycache__/
*.pyc

# Xcode
build/
DerivedData/
*.xcuserstate
xcuserdata/
*.xcscmblueprint
*.xccheckout
*.moved-aside
*.hmap
*.ipa
*.pkg
*.dSYM.zip
*.dSYM
/BlindadoMac.app/

# Swift Package Manager
.build/
.swiftpm/

# OpenDesign local workspace links (machine-local, not project source)
.opendesign/

# Ruby / Bundler (fastlane) — reinstale com `bundle install`, nunca commitar gems
vendor/bundle/
.bundle/

# fastlane — relatórios locais e QUALQUER credencial. Nada aqui deve ser versionado:
# App Store Connect API key (.p8/.json), .env com segredos, certificados/perfis do `match`.
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/screenshots/**/*.html
fastlane/screenshots_mac/**/*.png
fastlane/test_output/
fastlane/.env
fastlane/.env.*
!fastlane/.env.default
fastlane/*.p8
fastlane/*.p12
fastlane/*.mobileprovision
fastlane/*.cer

# `fastlane sigh` baixa o .mobileprovision na raiz quando rodado fora de uma lane com
# `filename:` explícito — nunca deve ir pro repositório público.
*.mobileprovision

# Team ID da Apple (identificador real da conta) — repositório é público
Local.xcconfig

# Contato de revisão da App Store (telefone real, nome) — repositório é público. O resto de
# fastlane/metadata*/ (descrição, keywords, categoria...) é texto de marketing sem dado pessoal
# sensível e fica versionado. Cobre tanto fastlane/metadata/ (iOS) quanto fastlane/metadata_mac/
# (macOS).
fastlane/metadata*/review_information/

# Cache local da tarefa agendada que monitora o status de revisão da App Store
.review_status_cache.json
