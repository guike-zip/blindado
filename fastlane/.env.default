# Copie para fastlane/.env (que está no .gitignore) e preencha com valores reais.
# Nunca commitar fastlane/.env — só este .env.default, sem segredos, deve ir pro git.

# Apple Developer Portal → Membership → Team ID
FASTLANE_TEAM_ID=

# E-mail da conta Apple Developer usada para autenticação interativa (fallback; prefira a
# App Store Connect API key abaixo, que evita 2FA em CI)
FASTLANE_APPLE_ID=

# App Store Connect → só necessário se a conta tiver mais de um time
FASTLANE_ITC_TEAM_ID=

# App Store Connect API key (recomendado — https://docs.fastlane.tools/app-store-connect-api/)
# Gerar em App Store Connect → Users and Access → Integrations → App Store Connect API.
# Baixe o .p8 UMA vez (a Apple não deixa baixar de novo) e guarde fora do git.
APP_STORE_CONNECT_API_KEY_KEY_ID=
APP_STORE_CONNECT_API_KEY_ISSUER_ID=
APP_STORE_CONNECT_API_KEY_FILEPATH=./fastlane/AuthKey.p8

# Telefone de contato para a revisão da Apple (App Review / Beta App Review) — formato
# internacional, ex: "+55 11 91234-5678". Nunca commitar o valor real.
FASTLANE_REVIEW_PHONE=
