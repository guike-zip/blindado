    "privacy.explanation" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To find a website, your iPhone asks a question called a DNS query. Blindado sends that question out encrypted, straight to the provider you chose."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para achar um site, seu iPhone faz uma pergunta chamada consulta DNS. O Blindado faz essa pergunta sair criptografada, direto para o provedor que você escolheu."
          }
        }
      }
    },
    "privacy.fact.no_account.body" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "No email, phone number, or sign-up." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Sem e-mail, telefone ou cadastro." } }
      }
