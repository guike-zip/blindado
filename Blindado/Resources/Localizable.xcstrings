    "home.body.not_configured" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blindado turns on encrypted DNS for the whole system — apps, games, and Safari. Takes less than a minute."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Blindado liga um DNS criptografado para o sistema inteiro — apps, jogos e Safari. Leva menos de um minuto."
          }
        }
      }
    },
    "home.body.pending" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The profile is already on your iPhone. For security, iOS asks you to confirm activation in Settings."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O perfil já está no seu iPhone. Por segurança, o iOS pede que você confirme a ativação nos Ajustes."
          }
        }
      }
    },
    "home.body.protected" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DNS queries leave encrypted. Known ads and trackers are blocked before they load."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As consultas DNS saem criptografadas. Anúncios e rastreadores conhecidos são bloqueados antes de carregar."
