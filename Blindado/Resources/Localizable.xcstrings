    "dns_error.conflict" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Another DNS or VPN configuration is already active on this iPhone. Resolve the conflict in Settings before protecting the device."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outra configuração de DNS ou VPN já está ativa neste iPhone. Resolva o conflito nos Ajustes antes de blindar o aparelho."
          }
        }
      }
    },
    "dns_error.invalid_url" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The address needs to start with https://." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O endereço precisa começar com https://." } }
      }
    },
    "dns_error.unreachable" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We couldn't reach that server. Check the address and try again."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não conseguimos falar com esse servidor. Confira o endereço e tente de novo."
          }
        }
      }
    },
    "home.action.blindar" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Protect my iPhone" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Blindar meu iPhone" } }
      }
    },
    "home.action.blindar.caption" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installs a DNS profile on your iPhone. You can remove it anytime."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instala um perfil de DNS no iPhone. Você pode remover quando quiser."
          }
        }
      }
    },
    "home.action.recheck" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "I already activated it — check again" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Já ativei — verificar de novo" } }
      }
    },
    "home.action.remove" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Remove protection" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Remover proteção" } }
      }
    },
    "home.action.test" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Test protection" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Testar a proteção" } }
      }
    },
    "home.activation_path.ios" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Settings › General › VPN & Device Management › DNS › Blindado"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustes › Geral › Gestão de VPN e Dispositivo › DNS › Blindado"
          }
        }
      }
    },
    "home.activation_path.mac" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System Settings › Network › Blindado › ••• › Make Service Active"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustes do Sistema › Rede › Blindado › ••• › Tornar Serviço Ativo"
          }
        }
      }
    },
    "home.activation_steps.ios.1" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Open the Settings app and tap General." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Abra o app Ajustes e toque em Geral." } }
      }
    },
    "home.activation_steps.ios.2" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Go to VPN & Device Management." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Entre em Gestão de VPN e Dispositivo." } }
      }
    },
    "home.activation_steps.ios.3" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Tap DNS and choose Blindado." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Toque em DNS e escolha Blindado." } }
      }
    },
    "home.activation_steps.mac.1" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Open System Settings and click Network." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Abra Ajustes do Sistema e clique em Rede." } }
      }
    },
    "home.activation_steps.mac.2" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A new \"Blindado\" service appears in the list on the left."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um novo serviço \"Blindado\" aparece na lista à esquerda."
          }
        }
      }
    },
    "home.activation_steps.mac.3" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click it, then the “•••” button, and choose Make Service Active."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique nele, depois no botão “•••” e escolha Tornar Serviço Ativo."
          }
        }
      }
    },
    "home.alert.conflict.confirm" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Got it" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Entendi" } }
      }
    },
    "home.alert.conflict.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "DNS/VPN Conflict" } },
