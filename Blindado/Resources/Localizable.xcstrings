    "level.footer" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Switching levels updates the profile automatically. Your iPhone stays protected during the switch."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trocar o nível atualiza o perfil automaticamente. Seu iPhone continua protegido durante a troca."
